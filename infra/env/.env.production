# Production environment variables
# IMPORTANT: override the secret values via a secrets manager or CI variables.
DB_USER=payment
DB_PASSWORD=REPLACE_ME_production_db_password
DB_NAME=paymentplatform_prod

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/paymentplatform_prod
SPRING_DATASOURCE_USERNAME=payment
SPRING_DATASOURCE_PASSWORD=REPLACE_ME_production_db_password
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

JWT_SECRET=REPLACE_ME_production_jwt_secret_min_32_chars_long
JWT_EXPIRATION_MS=3600000

AI_FRAUD_DETECTION_URL=http://fraud-detection:8001
AI_RISK_SCORING_URL=http://risk-scoring:8002
AI_KYC_URL=http://kyc-verification:8003
AI_CHATBOT_URL=http://chatbot:8004
AI_RECOMMENDATION_URL=http://recommendation:8005
AI_ROUTING_URL=http://routing-engine:8006

VITE_API_URL=https://api.payment-online.example/api

OLLAMA_BASE_URL=http://ollama:11434
