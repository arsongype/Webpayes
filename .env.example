# Payment Online Platform — Example environment file (Sprint 0)
# Copy to .env at the repository root and adjust as needed.
# Used by infra/docker-compose/docker-compose.yml and local dev.

# --- Database (PostgreSQL) ---
DB_USER=payment
DB_PASSWORD=payment
DB_NAME=paymentplatform

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8081
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/paymentplatform
SPRING_DATASOURCE_USERNAME=payment
SPRING_DATASOURCE_PASSWORD=payment
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Auth (JWT) ---
JWT_SECRET=change_me_dev_secret_please_override_in_prod_min_32_chars
JWT_EXPIRATION_MS=86400000

# --- AI microservices (internal URLs inside the compose network) ---
AI_FRAUD_DETECTION_URL=http://fraud-detection:8001
AI_RISK_SCORING_URL=http://risk-scoring:8002
AI_KYC_URL=http://kyc-verification:8003
AI_CHATBOT_URL=http://chatbot:8004
AI_RECOMMENDATION_URL=http://recommendation:8005
AI_ROUTING_URL=http://routing-engine:8006

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8081/api

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://ollama:11434
